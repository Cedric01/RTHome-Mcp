<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Matches RTHomePropertyManagement's current target (net9.0). Bump both projects
         together if/when you move the API to net10.0. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b1e2c3a4-5f6d-4e7c-9a8b-0123456789ab</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

</Project>
